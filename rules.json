{
  "rules": {
    "moshpin": {
      "library_index": {
        ".read": true,
        "$slug": {
          ".write": "auth != null"
        }
      },
      "library": {
        ".read": true,
        "$slug": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name','year'])"
        }
      },
      "groups": {
        "$gid": {
          ".write": "auth != null && !data.exists() && newData.hasChildren(['meta','join','admins','members'])",
          "meta": {
            ".read": true,
            ".write": "auth != null && data.exists()"
          },
          "join": {
            ".read": false,
            ".write": "auth != null"
          },
          "admins": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null"
            }
          },
          "members": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null && (data.exists() || root.child('moshpin/groups/'+$gid+'/join/'+newData.child('t').val()).exists())",
              ".validate": "!newData.exists() || newData.hasChild('name')"
            }
          },
          "photos": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null"
            }
          },
          "festival": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "config": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "checkins": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null"
            }
          },
          "chat": {
            ".read": "auth != null",
            "$msg": {
              ".write": "auth != null"
            }
          },
          "reactions": {
            ".read": "auth != null",
            "$msg": {
              "$k": {
                ".write": "auth != null"
              }
            }
          },
          "notevotes": {
            ".read": "auth != null",
            "$a": {
              "$author": {
                "$voter": {
                  ".write": "auth != null"
                }
              }
            }
          },
          "tally": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null"
            }
          },
          "feedback": {
            ".read": false,
            "$id": {
              ".write": "auth != null"
            }
          },
          "transport": {
            ".read": "auth != null",
            "$k": {
              ".write": "auth != null"
            }
          },
          "festv": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "code": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      },
      "requests": {
        ".read": false,
        "$id": {
          ".write": "auth != null"
        }
      },
      "feedback": {
        ".read": false,
        "$id": {
          ".write": "auth != null"
        }
      },
      "stats": {
        ".read": true,
        "$key": {
          ".write": "auth != null"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}