{
  "rules": {
    "moshpin": {
      "library_index": {
        ".read": true,
        "$slug": {
          ".write": "auth != null"
        }
      },
      "library": {
        ".read": true,
        "$slug": {
          ".write": "auth != null && (!data.exists() || newData.child('updatedAt').val() > data.child('updatedAt').val())",
          ".validate": "newData.hasChildren(['name','year','updatedAt'])"
        }
      },
      "groups": {
        "$gid": {
          ".write": "auth != null && !data.exists() && newData.hasChildren(['meta','join','admins','members','uidmap'])",
          "meta": {
            ".read": true,
            ".write": "auth != null && data.exists() && root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists()"
          },
          "join": {
            ".read": false,
            ".write": "auth != null && root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists()"
          },
          "admins": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists()"
            }
          },
          "members": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && (($k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()) || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists() || (!data.exists() && (!root.child('moshpin/groups/'+$gid+'/config/lock').exists() || root.child('moshpin/groups/'+$gid+'/join/'+newData.child('t').val()).exists())))",
              ".validate": "!newData.exists() || newData.hasChild('name')"
            }
          },
          "photos": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && ($k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())"
            }
          },
          "festival": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            ".write": "auth != null && root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists()"
          },
          "config": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            ".write": "auth != null && root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists()"
          },
          "checkins": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && ($k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())"
            }
          },
          "chat": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$msg": {
              ".write": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists() && (!data.exists() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())",
              ".validate": "!newData.exists() || newData.child('u').val() === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()"
            }
          },
          "reactions": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$msg": {
              "$k": {
                ".write": "auth != null && $k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()"
              }
            }
          },
          "notevotes": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$a": {
              "$author": {
                "$voter": {
                  ".write": "auth != null && $voter === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()"
                }
              }
            }
          },
          "tally": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && ($k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())"
            }
          },
          "feedback": {
            ".read": false,
            "$id": {
              ".write": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()"
            }
          },
          "transport": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && ($k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())"
            }
          },
          "festv": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            ".write": "auth != null && root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists()"
          },
          "code": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists()",
            ".write": "auth != null && root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists()"
          },
          "uidmap": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$uid": {
              ".read": "auth != null && $uid === auth.uid",
              ".write": "auth != null && $uid === auth.uid && (root.child('moshpin/groups/'+$gid+'/join/'+newData.child('t').val()).exists() || root.child('moshpin/groups/'+$gid+'/members/'+newData.child('k').val()).exists())",
              ".validate": "newData.hasChild('k')"
            }
          },
          "pk": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && ($k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())"
            }
          },
          "rt": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && ($k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())"
            }
          },
          "nt": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".write": "auth != null && ($k === root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())"
            }
          },
          "pending": {
            ".read": "auth != null && root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid).exists()",
            "$k": {
              ".read": "auth != null",
              ".write": "auth != null && (!data.exists() || root.child('moshpin/groups/'+$gid+'/admins/'+root.child('moshpin/groups/'+$gid+'/uidmap/'+auth.uid+'/k').val()).exists())"
            }
          }
        }
      },
      "stats": {
        ".read": true,
        "counts": {
          "$key": {
            ".write": "auth != null"
          }
        },
        "feedback": {
          "$id": {
            ".write": "auth != null && !data.exists()"
          }
        },
        "requests": {
          "$id": {
            ".write": "auth != null && !data.exists()"
          }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}